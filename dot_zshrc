##
## Global Configuration
################################################################################
export PATH="${HOME}/.bin:${PATH}"                                               # Add My bin alias files to PATH
[ -f "${HOME}/.env" ] && source "${HOME}/.env"

##
## Oh My Zsh Configuration
################################################################################
export ZSH="$HOME/.oh-my-zsh"                                                   # Path to Oh My Zsh installation.

ZSH_THEME="avit"                                                                # Theme in use
CASE_SENSITIVE="false"                                                          # Case-insensitive completion
HYPHEN_INSENSITIVE="true"                                                       # treats _ and - as interchangeable
zstyle ':omz:update' mode auto                                                  # 'disabled' or 'auto' or 'reminder'
zstyle ':omz:update' frequency 3                                                # days between updates
DISABLE_MAGIC_FUNCTIONS="true"                                                  # Uncomment the following line if pasting URLs and other text is messed up.
DISABLE_LS_COLORS="true"                                                        # Uncomment the following line to disable colors in ls.
DISABLE_AUTO_TITLE="true"                                                       # Uncomment the following line to disable auto-setting terminal title.
ENABLE_CORRECTION="true"                                                        # Command auto-correction
COMPLETION_WAITING_DOTS="true"                                                  # Completion waiting dots
DISABLE_UNTRACKED_FILES_DIRTY="true"                                            # Uncomment to disable marking untracked files under VCS as dirty\ (faster for large repos)

HIST_STAMPS="yyyy-mm-dd"                                                        # timestamp format in history
HISTSIZE=10000                                                                  # History size
SAVEHIST=10000                                                                  # Save history size
plugins=(   git                                                                 # Git
            docker                                                              # Docker
            docker-compose                                                      # Docker Compose
            terraform                                                           # Terraform
            mvn                                                                 # Maven
            ssh-agent                                                           # SSH Agent
            node                                                                # Node
            zsh-autosuggestions                                                 # Zsh Autosuggestions
            zsh-syntax-highlighting                                             # Zsh Syntax Highlighting
            brew                                                                # Homebrew
            sdkman                                                              # SDKMAN
)
ZSH_DISABLE_COMPFIX="true"                                                      # Skip directory permission checks
source $ZSH/oh-my-zsh.sh                                                        # Load Oh My Zsh

##
## HomeBrew Configuration
################################################################################
export HOMEBREW_PREFIX=~/.homebrew                                              # HomeBrew prefix
export HOMEBREW_MAKE_JOBS=8                                                     # Use all cores for building when it's necessary
export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_UPGRADE_GREEDY=1                                                # Upgrade all packages, include the ones that has auto update setup.
export HOMEBREW_FORBIDDEN_FORMULAE=colima                                       # aways use rootless directories
export HOMEBREW_CASK_OPTS="--appdir=$HOME/Applications"  # aways use rootless directories (mirrors .zshrc)
PATH="${HOMEBREW_PREFIX}/bin:${PATH}"                                           # Add HomeBrew bin to PATH
zstyle ':completion:*' rehash true
unsetopt CORRECT
unsetopt CORRECT_ALL

alias zshrc='${EDITOR:-nano} ~/.zshrc'                                          # Edit .zshrc file with default editor
alias reload='source ~/.zshrc'                                                  # Reload .zshrc file

## Android SDK``
################################################################################
export ANDROID_HOME="$HOME/Library/Android/sdk"
export PATH="$ANDROID_HOME/platform-tools:$ANDROID_HOME/emulator:$PATH"

## Modern CLI Tools
################################################################################

# Better cat|less
alias cat='bat --paging=never'
alias less='bat'

# Better ls
alias ls='eza --icons'
alias ll='eza -lh --icons --git'
alias la='eza -lah --icons --git'
alias lt='eza -T --icons --level=2'

# Better grep
#alias grep='rg'

# Better find (used by fzf automatically if installed)
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

. "$HOME/.local/bin/env"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"

# Added by LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"
